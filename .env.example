# VirtualLearn AI — Environment Configuration Example
# Copy this file to .env and set your own values.
# NEVER commit your real .env file with secrets to Git.

# Server Port
PORT=3000

# Google Gemini API Key (Optional — Free Tier from https://aistudio.google.com/)
# If not provided, the backend automatically uses clearly labeled demo AI responses.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
